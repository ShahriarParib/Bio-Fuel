# Copy to .env (never commit .env). All values below are safe local-demo defaults.

# ---------- host ports (change if something on your machine already uses them) ----------
SIM_HOST_PORT=8000
PG_HOST_PORT=15432
REDIS_HOST_PORT=16379
INTEL_HOST_PORT=8200
ENGINE_HOST_PORT=8100
API_HOST_PORT=18080
FE_HOST_PORT=3000
PROM_HOST_PORT=9090
GRAFANA_HOST_PORT=13001

# ---------- simulator (set explicitly; the PDF defaults are wrong) ----------
SIMULATION_SPEED=0.5
TICK_MINUTES=15
SIMULATOR_START_MODE=paused

# ---------- internal URLs (container network; do not change unless you rename services) ----------
SIM_BASE_URL=http://simulator:8000
INTELLIGENCE_URL=http://intelligence:8200
ENGINE_INTERNAL_URL=http://engine:8100
DATABASE_URL=postgresql+asyncpg://fsip:change-me@timescaledb:5432/fsip
REDIS_URL=redis://redis:6379/0

# ---------- database ----------
POSTGRES_USER=fsip
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fsip

# ---------- engine ----------
ENGINE_MODE=advisory
ENGINE_POLICY=optimizer
ENGINE_DECISION_INTERVAL_TICKS=1
DECISION_TTL_TICKS=8
ENGINE_POLL_INTERVAL_SEC=1.0
SIM_TIMEOUT_SEC=2.0
SIM_MAX_RETRIES=3
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_SEC=15
INTELLIGENCE_TIMEOUT_SEC=1.5
AUTO_APPROVE_MAX_LITERS=7000
AUTO_APPROVE_MIN_CONFIDENCE=0.7
DEPOT_RESERVE_FRACTION=0
PLANNING_HORIZON_TICKS=96
SAFETY_TICKS=16
ENGINE_INTERNAL_TOKEN=change-me-internal

# ---------- api ----------
API_OPERATOR_TOKEN=change-me-operator
API_SUPERVISOR_TOKEN=change-me-supervisor
API_RATE_LIMIT_PER_MIN=600
DEMO_CONTROLS=true

# ---------- observability ----------
LOG_LEVEL=INFO
GRAFANA_ADMIN_PASSWORD=change-me
APP_VERSION=dev
SLO_POLICY=enforce

# ---------- plain-language assistant (optional) ----------
# Leave GEMINI_API_KEY empty and the explain endpoints serve the platform's own written summaries instead.
# The assistant only re-words facts the platform computed; it never makes or changes a decision.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# the spare is tried only when the primary is overloaded or retired (we measured both)
GEMINI_SPARE_MODEL=gemini-flash-lite-latest
LLM_TIMEOUT_SEC=4
LLM_BUDGET_SEC=6
