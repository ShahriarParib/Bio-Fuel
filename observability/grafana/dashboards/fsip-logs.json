{
 "uid": "fsip-logs",
 "title": "FSIP - Logs & Incidents",
 "description": "Structured JSON logs from Loki; incidents and mode changes.",
 "tags": [
  "fsip"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Incidents opened by component",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (component) (increase(fsip_incidents_total[5m]))",
     "legendFormat": "{{component}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Log volume by level",
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (level) (count_over_time({service=~\".+\"}[1m]))",
     "legendFormat": "{{level}}",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "type": "logs",
   "title": "Decisions and allocations",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 24,
    "h": 9
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=\"engine\"} |~ \"decision\\\\.|allocation\\\\.\"",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   }
  },
  {
   "id": 4,
   "type": "logs",
   "title": "Incidents, fallbacks, breakers, mode changes",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 24,
    "h": 9
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=\"engine\"} |~ \"incident\\\\.|fallback\\\\.|breaker\\\\.|mode_changed|reset\\\\.detected\"",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   }
  },
  {
   "id": 5,
   "type": "logs",
   "title": "Warnings and errors (all services)",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 9
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{level=~\"warning|error\"}",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   }
  }
 ],
 "annotations": {
  "list": [
   {
    "name": "Engine mode changes",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "orange",
    "expr": "changes(fsip_engine_mode{mode=\"NORMAL\"}[1m]) > 0",
    "step": "15s",
    "titleFormat": "engine mode changed"
   }
  ]
 },
 "links": [
  {
   "title": "FSIP dashboards",
   "type": "dashboards",
   "tags": [
    "fsip"
   ],
   "asDropdown": true
  }
 ]
}
